Options -Indexes
RewriteEngine On

# Internal application data must never be served as public files.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:app|config|database|storage|extensions|tests|update-package|dist|vendor|node_modules)(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(?:bak|old|orig|save|swp|sql|log)(?:\.[^/]*)?$ - [F,L,NC]
RewriteRule ^public/(?!index\.php$).*\.(?:php[0-9]*|phtml|phar|cgi|pl)(?:/|$|\.) - [F,L,NC]

RewriteCond %{REQUEST_URI} !/public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
